{
  "$schema": "https://schema.up.railway.app/railway.json",
  "build": {
    "builder": "dockerfile",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "/code/start.sh",
    "healthcheckPath": "/api/system",
    "healthcheckTimeout": 300,
    "restartPolicyType": "onFailure",
    "restartPolicyMaxRetries": 5
  }
}
