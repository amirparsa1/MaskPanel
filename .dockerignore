# MaskPanel by RunoFlux - Dockerignore for Railway
# Optimized to allow Railway Dockerfile builds

# Node modules - will be installed in dashboard-builder stage
**/node_modules
dashboard/node_modules

# Logs
*.log
*.pyc
*.pyd
*.pyo
__pycache__
.pytest_cache
.ruff_cache
.uv-cache
.mypy_cache

# Git and IDE
.git
.gitignore
.idea
.vscode
*.code-workspace

# Env - Railway provides via variables
.env
.env.local
.env.development
.env.production

# DB
db.sqlite3
db.sqlite3-journal
test.db
*.db-journal

# Caches
*.pyc
venv*
.venv*

# Docs - keep README for branding but ignore others for smaller context
README-fa.md
README-ru.md
README-zh-cn.md
LICENSE
CONTRIBUTING.md

# CI
.github

# Scripts - keep railway_setup.py
# scripts/ - we need this for Railway, so don't ignore

# Tests
tests

# Assets - keep logos but ignore videos
assets/*.mp4
assets/*.mov

# Dashboard source - we build it in Dockerfile stage, but we need package files
# So ignore only heavy build output, keep source for Railpack fallback
# dashboard/build - keep for runtime, ignore for build context? Actually we build it, so ignore existing build
# We will NOT ignore dashboard/* anymore - Railway needs to see package.json

# For Docker multi-stage, we want dashboard source, so don't ignore
# Only ignore prebuilt if exists to force rebuild
# dashboard/build

# Misc
v2ray-core
xray-core
install_service.sh
PasarGuard.code-workspace

# Allow Dockerfile for Railway!
!Dockerfile
!Dockerfile.*
!railway.json
!railway.toml
!nixpacks.toml
!railpack.json
!start.sh
!cli_wrapper.sh
!tui_wrapper.sh
!healthcheck.sh
!Procfile
!RAILWAY.md
!RUNOFLUX.md
